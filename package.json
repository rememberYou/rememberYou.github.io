    "react-dom": "^19.1.0",
    "react-html-parser": "^2.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.21.0",
