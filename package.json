    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "svg-url-loader": "^8.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.8.3",
    "url-loader": "^4.1.1",
