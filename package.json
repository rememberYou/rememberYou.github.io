    "prettier": "^3.6.2",
    "pretty-quick": "^4.0.0",
    "sass": "^1.89.2",
    "sass-loader": "^16.0.4",
    "style-loader": "^4.0.0",
    "svg-url-loader": "^8.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.8.3",
    "url-loader": "^4.1.1",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
