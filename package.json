    "react-html-parser": "^2.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.51.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.34.0",
