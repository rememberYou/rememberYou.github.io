---
import { Font, getImage } from 'astro:assets';

import portrait from '../assets/portrait.png';
import { person } from '../data/profile';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: portrait, width: 800, format: 'jpg' });
const ogImageUrl = new URL(ogImage.src, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: `${person.firstName} ${person.lastName}`,
  jobTitle: person.role,
  url: canonical.href,
  image: ogImageUrl.href,
  email: `mailto:${person.email}`,
  address: { '@type': 'PostalAddress', addressCountry: 'BE', addressRegion: person.region },
  sameAs: [person.linkedin, person.github],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="theme-color" content="#f4f0e2" />
    <script is:inline>
      // The season from the month, and day or evening from whether the sun is
      // up where the visitor is, before the first paint so the page never
      // flashes the wrong colours; then every minute, so an open page darkens
      // at sunset. The browser's own bar follows, through theme-color.
      (() => {
        const backgrounds = {
          'autumn-day': '#f4f0e2',
          'autumn-evening': '#1d1712',
          'winter-day': '#ece8da',
          'winter-evening': '#11172a',
        };
        const root = document.documentElement;
        const meta = document.querySelector('meta[name="theme-color"]');

        // Where the visitor is, roughly: Brussels for its neighbours, else the
        // middle of their time zone, at a mid latitude.
        const zone = Intl.DateTimeFormat().resolvedOptions().timeZone;
        const near = /^Europe\/(Brussels|Paris|Amsterdam|Luxembourg)$/.test(zone);
        const year = new Date().getFullYear();
        const standardOffset = Math.max(
          new Date(year, 0, 1).getTimezoneOffset(),
          new Date(year, 6, 1).getTimezoneOffset(),
        );
        const lat = near ? 50.85 : 45;
        const lng = near ? 4.35 : -standardOffset / 4;

        // Whether the sun is above the horizon: its position from the date,
        // accurate to a few minutes of the published sunrise and sunset.
        const rad = Math.PI / 180;
        const sunUp = (date) => {
          const d = date / 864e5 - 10957.5;
          const g = (357.529 + 0.98560028 * d) * rad;
          const l = (280.459 + 0.98564736 * d + 1.915 * Math.sin(g) + 0.02 * Math.sin(2 * g)) * rad;
          const e = (23.439 - 3.6e-7 * d) * rad;
          const ra = Math.atan2(Math.cos(e) * Math.sin(l), Math.cos(l));
          const dec = Math.asin(Math.sin(e) * Math.sin(l));
          const h = (280.46061837 + 360.98564736629 * d + lng) * rad - ra;
          const altitude =
            Math.sin(lat * rad) * Math.sin(dec) + Math.cos(lat * rad) * Math.cos(dec) * Math.cos(h);
          return altitude > Math.sin(-0.833 * rad);
        };

        const apply = () => {
          const now = new Date();
          const month = now.getMonth() + 1;
          const season = month === 12 || month <= 3 ? 'winter' : 'autumn';
          const time = sunUp(now) ? 'day' : 'evening';
          root.dataset.season = season;
          root.dataset.time = time;
          meta?.setAttribute('content', backgrounds[`${season}-${time}`]);
        };
        apply();
        root.classList.add('js');
        setInterval(apply, 60_000);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImage.attributes.width)} />
    <meta property="og:image:height" content={String(ogImage.attributes.height)} />
    <meta property="profile:first_name" content={person.firstName} />
    <meta property="profile:last_name" content={person.lastName} />
    <meta name="twitter:card" content="summary" />

    <Font cssVariable="--font-name" preload />
    <Font cssVariable="--font-title" preload />
    <Font cssVariable="--font-body" preload />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
    <script>
      // Reveal each block once, as it enters the viewport.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('in');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.1 },
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
