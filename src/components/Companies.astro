---
import type { SvgComponent } from 'astro/types';

import { companies } from '../data/profile';

// The logos are inlined SVGs, so their currentColor parts follow the theme and
// they appear with the page, without a request of their own.
const logos = companies.map(({ name, src, height, ink }) => {
  const width = Math.round((height * src.width) / src.height);
  const style = `--h: ${height}px; --w: ${width}px; ${ink ? `--ink: ${ink};` : ''}`;
  return { name, style, Svg: src as unknown as SvgComponent };
});
---

<div class="companies">
  <div class="wrap">
    <p class="label reveal">Experience with</p>
    <ul class="logos reveal">
      {logos.map(({ name, style, Svg }) => (
        <li style={style}>
          <Svg role="img" aria-label={name} />
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .companies {
    border-block: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 45%, transparent);
  }

  .wrap {
    display: grid;
    grid-template-columns: 170px 1fr;
    align-items: center;
    min-height: 108px;
  }

  .label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--soft);
  }

  .logos {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 28px;
    list-style: none;
  }

  /* By day, the original colours; by evening, the dark parts take the text
     colour so they stay visible. */
  .logos li {
    display: flex;
    color: var(--ink, var(--text));
  }

  :global([data-time='evening']) .logos li {
    color: var(--text);
  }

  .logos :global(svg) {
    height: var(--h);
    width: var(--w);
  }

  @media (max-width: 920px) {
    .wrap {
      grid-template-columns: 1fr;
      gap: 20px;
      padding-block: 26px;
      text-align: center;
    }

    .logos {
      flex-wrap: wrap;
      justify-content: center;
      gap: 22px 30px;
    }

    .logos :global(svg) {
      height: calc(var(--h) * 0.75);
      width: calc(var(--w) * 0.75);
    }
  }

  /* When the six no longer fit on one line, full rows of three, then of two:
     never one logo left alone on a row. */
  @media (max-width: 640px) {
    .logos {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      justify-items: center;
      gap: 22px 12px;
    }
  }

  @media (max-width: 340px) {
    .logos {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
