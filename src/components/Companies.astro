---
import { getImage } from 'astro:assets';
import type { SvgComponent } from 'astro/types';

import { companies } from '../data/profile';

// SVG logos are inlined, so their currentColor parts follow the theme. A PNG
// logo is single-colour; it is used as a mask over currentColor instead, which
// renders it the same way.
const logos = await Promise.all(
  companies.map(async ({ name, src, height, ink }) => {
    const width = Math.round((height * src.width) / src.height);
    const style = `--h: ${height}px; --w: ${width}px; ${ink ? `--ink: ${ink};` : ''}`;
    if (src.format === 'svg') {
      return { name, style, Svg: src as unknown as SvgComponent };
    }
    const mask = await getImage({ src, height: height * 2, format: 'webp' });
    return { name, style: `${style} --mask: url(${mask.src});` };
  }),
);
---

<div class="companies">
  <div class="wrap">
    <p class="label">Experience with</p>
    <ul class="logos">
      {logos.map(({ name, style, Svg }) => (
        <li style={style}>
          {Svg ? (
            <Svg role="img" aria-label={name} />
          ) : (
            <span class="mask" role="img" aria-label={name} />
          )}
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .companies {
    border-block: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 45%, transparent);
  }

  .wrap {
    display: grid;
    grid-template-columns: 170px 1fr;
    align-items: center;
    min-height: 108px;
  }

  .label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--soft);
  }

  .logos {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 28px;
    list-style: none;
  }

  /* By day, the original colours; by evening, the dark parts take the text
     colour so they stay visible. */
  .logos li {
    display: flex;
    color: var(--ink, var(--text));
  }

  :global([data-time='evening']) .logos li {
    color: var(--text);
  }

  .logos :global(svg),
  .mask {
    height: var(--h);
    width: var(--w);
  }

  .mask {
    display: block;
    background: currentColor;
    mask: var(--mask) center / contain no-repeat;
  }

  @media (max-width: 920px) {
    .wrap {
      grid-template-columns: 1fr;
      gap: 20px;
      padding-block: 26px;
      text-align: center;
    }

    .logos {
      flex-wrap: wrap;
      justify-content: center;
      gap: 22px 30px;
    }

    .logos :global(svg),
    .mask {
      height: calc(var(--h) * 0.75);
      width: calc(var(--w) * 0.75);
    }
  }
</style>
