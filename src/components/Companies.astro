---
import { Image } from 'astro:assets';

import { companies } from '../data/profile';
---

<div class="companies">
  <div class="wrap">
    <p class="label">Experience with</p>
    <ul class="logos">
      {companies.map(({ name, src, height }) => (
        <li>
          <Image
            src={src}
            alt={name}
            height={height}
            densities={[1, 2]}
            style={`--h: ${height}px`}
          />
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .companies {
    border-block: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 45%, transparent);
  }

  .wrap {
    display: grid;
    grid-template-columns: 170px 1fr;
    align-items: center;
    min-height: 108px;
  }

  .label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--soft);
  }

  .logos {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 28px;
    list-style: none;
  }

  .logos :global(img) {
    height: var(--h);
    width: auto;
    filter: var(--logo-filter);
    opacity: 0.9;
    transition:
      filter 0.3s,
      opacity 0.3s;
  }

  .logos :global(img:hover) {
    filter: none;
    opacity: 1;
  }

  @media (max-width: 920px) {
    .wrap {
      grid-template-columns: 1fr;
      gap: 20px;
      padding-block: 26px;
      text-align: center;
    }

    .logos {
      flex-wrap: wrap;
      justify-content: center;
      gap: 22px 30px;
    }

    .logos :global(img) {
      height: calc(var(--h) * 0.75);
    }
  }
</style>
