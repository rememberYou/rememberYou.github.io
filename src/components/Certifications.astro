---
import { Image } from 'astro:assets';

import { certifications, person } from '../data/profile';
---

<section id="certifications" class="certs" aria-labelledby="certifications-title">
  <div class="wrap">
    <div class="head reveal">
      <div>
        <p class="kicker">Certifications</p>
        <h2 id="certifications-title">Proven on two clouds.</h2>
        <p class="lede">Certifications on AWS, Azure and Scrum, up to the professional level.</p>
      </div>
      <a class="verify" href={person.credly} rel="noopener">
        Verify on Credly →
      </a>
    </div>
    {certifications.map(({ tier, items }, index) => (
      <div class="tier">
        <h3 class="reveal">{tier}</h3>
        <ul class:list={['badges', { pro: index === 0 }]}>
          {items.map(({ name, issuer, year, badge }) => (
            <li class="badge reveal">
              <Image
                src={badge}
                alt=""
                width={index === 0 ? 104 : 58}
                densities={[1, 2]}
                loading="lazy"
              />
              <div>
                <b>{name}</b>
                <span>
                  {issuer} · {year}
                </span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .certs {
    position: relative;
    overflow: hidden;
    background: var(--deep);
    color: var(--deep-text);
  }

  .certs::after {
    content: '';
    position: absolute;
    width: 760px;
    height: 760px;
    right: -280px;
    top: -340px;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--primary) 34%, transparent),
      transparent
    );
    pointer-events: none;
  }

  .wrap {
    position: relative;
    z-index: 1;
  }

  .kicker {
    color: var(--gold);
  }

  .lede {
    color: var(--deep-soft);
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
  }

  .verify {
    color: var(--gold);
    font-weight: 600;
    font-size: 15px;
    white-space: nowrap;
  }

  .verify:hover {
    color: var(--deep-text);
  }

  h3 {
    margin-top: 44px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--deep-soft);
  }

  .badges {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-top: 14px;
    list-style: none;
  }

  .badges.pro {
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .badge {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 18px;
    border-radius: 18px;
    background: rgb(255 255 255 / 0.045);
    border: 1px solid rgb(255 255 255 / 0.08);
    transition:
      transform 0.3s,
      border-color 0.3s;
  }

  .badge:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--gold) 70%, transparent);
  }

  .badge :global(img) {
    flex: none;
  }

  .pro .badge {
    gap: 24px;
    padding: 28px;
    background: linear-gradient(120deg, rgb(255 255 255 / 0.09), rgb(255 255 255 / 0.02));
  }

  b {
    display: block;
    font-family: var(--font-title);
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.35;
  }

  .pro b {
    font-size: 20px;
  }

  .badge span {
    font-size: 12.5px;
    color: var(--deep-soft);
  }

  @media (max-width: 920px) {
    .head {
      flex-direction: column;
      align-items: start;
    }

    .badges,
    .badges.pro {
      grid-template-columns: 1fr;
    }

    .pro .badge {
      gap: 16px;
      padding: 20px;
    }

    .pro .badge :global(img) {
      width: 72px;
      height: 72px;
    }

    .pro b {
      font-size: 17px;
    }
  }
</style>
