---
import { experience } from '../data/profile';
---

<section id="experience" class="experience" aria-labelledby="experience-title">
  <div class="wrap">
    <div class="reveal">
      <p class="kicker">Experience</p>
      <h2 id="experience-title">Where I've made an impact.</h2>
    </div>
    <ol class="timeline">
      {experience.map(({ period, place, role, company, summary, stack, current }) => (
        <li class:list={['job', 'reveal', { current }]}>
          <p class="when">
            {current && <span class="now">Current</span>}
            {period}
            <span class="place">{place}</span>
          </p>
          <div>
            <h3>
              {role} <small>· {company}</small>
            </h3>
            <p class="summary">{summary}</p>
            <ul class="stack" aria-label="Technologies">
              {stack.map((tech) => (
                <li>{tech}</li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .experience {
    padding-top: 0;
  }

  .timeline {
    margin-top: 56px;
    border-left: 1.5px solid var(--border);
    list-style: none;
  }

  .job {
    position: relative;
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 32px;
    padding: 0 0 40px 36px;
  }

  .job::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 8px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--primary);
  }

  .job.current::before {
    background: var(--primary);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--primary) 22%, transparent);
  }

  .now {
    display: inline-block;
    margin-right: 8px;
    padding: 1px 8px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--on-primary);
    background: var(--primary);
  }

  .when {
    font-size: 14px;
    font-weight: 500;
    color: var(--soft);
  }

  .place {
    display: block;
    margin-top: 2px;
    font-size: 13px;
    font-weight: 400;
  }

  h3 {
    font-family: var(--font-title);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.3px;
    line-height: 1.3;
  }

  small {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--soft);
  }

  .summary {
    margin-top: 6px;
    max-width: 640px;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--soft);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
    list-style: none;
  }

  .stack li {
    font-size: 12px;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 6px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--soft);
  }

  @media (max-width: 920px) {
    .job {
      grid-template-columns: 1fr;
      gap: 6px;
      padding-left: 26px;
    }
  }
</style>
