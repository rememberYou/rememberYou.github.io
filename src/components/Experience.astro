---
import { experience, type Mission } from '../data/profile';

/** Splits a summary around its linked phrase, when it has one. */
function split({ summary, link }: Mission): (string | NonNullable<Mission['link']>)[] {
  const at = link ? summary.indexOf(link.text) : -1;
  if (!link || at < 0) return [summary];
  return [summary.slice(0, at), link, summary.slice(at + link.text.length)];
}

// The oldest missions are folded under a button, so the timeline reads from
// the current work; they stay in the page for search engines and without
// JavaScript.
const earlier = experience.flatMap(({ earlier, missions }) =>
  missions.filter((mission) => earlier || mission.earlier),
);
const years = earlier.flatMap(({ period }) => period.match(/\d{4}/g) ?? []).sort();
const span = years.length ? `${years[0]}–${years.at(-1)}` : '';
---

<section id="experience" class="experience" aria-labelledby="experience-title">
  <div class="wrap">
    <div class="reveal">
      <p class="kicker">Experience</p>
      <h2 id="experience-title">Where I've made an impact.</h2>
      <p class="lede">By employer, with the clients I worked for as a consultant.</p>
    </div>
    <ol class="timeline" id="experience-list">
      {experience.map(({ name, period, summary, current, earlier, missions }) => (
        <li class:list={['employer', 'reveal', { current, earlier }]}>
          <div class="head">
            <h3>
              {name}
              {current && <span class="now">Current</span>}
            </h3>
            <p class="period">{period}</p>
            {summary && <p class="about">{summary}</p>}
          </div>
          <ol class="missions">
            {missions.map((mission) => (
              <li class:list={['mission', { earlier: mission.earlier }]}>
                <h4>{mission.client ?? mission.role}</h4>
                {mission.client && <p class="role">{mission.role}</p>}
                <p class="meta">
                  {missions.length > 1 ? `${mission.period} · ${mission.place}` : mission.place}
                </p>
                <p class="summary">
                  {split(mission).map((part) =>
                    typeof part === 'string' ? (
                      part
                    ) : (
                      <a href={part.url} download>
                        {part.text}
                      </a>
                    ),
                  )}
                </p>
                <ul class="stack" aria-label="Technologies">
                  {mission.stack.map((tech) => (
                    <li>{tech}</li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
        </li>
      ))}
    </ol>
    {earlier.length > 0 && (
      <button class="more" type="button" aria-expanded="false" aria-controls="experience-list">
        <span class="label">Show earlier experience</span>
        <span class="count">
          {earlier.length} roles · {span}
        </span>
      </button>
    )}
  </div>
</section>

<script>
  const timeline = document.getElementById('experience-list');
  const more = document.querySelector<HTMLButtonElement>('#experience .more');
  more?.addEventListener('click', () => {
    const open = timeline!.classList.toggle('open');
    more.setAttribute('aria-expanded', String(open));
    more.querySelector('.label')!.textContent = open
      ? 'Hide earlier experience'
      : 'Show earlier experience';
    if (open) {
      window.goatcounter?.count({ path: 'show earlier experience', event: true });
    } else {
      // The roles above it have folded away: bring the button back into view.
      more.scrollIntoView({ block: 'center' });
    }
  });
</script>

<style>
  .experience {
    padding-top: 0;
  }

  /* Folded until the button opens them; without JavaScript, all shown. */
  :global(.js) .timeline:not(.open) .earlier {
    display: none;
  }

  .more {
    display: none;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 4px 12px;
    margin: 8px 0 0 36px;
    padding: 12px 22px;
    border: 1.5px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    font: inherit;
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.25s;
  }

  :global(.js) .more {
    display: inline-flex;
  }

  .more:hover {
    border-color: var(--primary);
  }

  .more .label {
    font-family: var(--font-title);
    font-size: 15px;
    font-weight: 600;
  }

  .more .count {
    font-size: 13px;
    color: var(--soft);
  }

  .timeline {
    margin-top: 56px;
    border-left: 1.5px solid var(--border);
    list-style: none;
  }

  .employer {
    position: relative;
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 40px;
    padding: 0 0 48px 36px;
  }

  .employer::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 9px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--primary);
  }

  .employer.current::before {
    background: var(--primary);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--primary) 22%, transparent);
  }

  h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-title);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.4px;
    line-height: 1.3;
  }

  .now {
    padding: 1px 8px;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--on-primary);
    background: var(--primary);
  }

  .period {
    margin-top: 4px;
    font-size: 14px;
    font-weight: 500;
    color: var(--soft);
  }

  .about {
    margin-top: 10px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--soft);
  }

  .missions {
    display: grid;
    gap: 28px;
    list-style: none;
  }

  .mission + .mission {
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }

  h4 {
    font-family: var(--font-title);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.3px;
    line-height: 1.3;
  }

  .role {
    margin-top: 2px;
    font-size: 15px;
    font-weight: 600;
    color: var(--primary);
  }

  .meta {
    margin-top: 4px;
    font-size: 13.5px;
    color: var(--soft);
  }

  .summary {
    margin-top: 8px;
    max-width: 640px;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--soft);
  }

  .summary a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--primary);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
    transition: color 0.3s;
  }

  .summary a:hover {
    color: var(--primary);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
    list-style: none;
  }

  .stack li {
    font-size: 12px;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 6px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--soft);
  }

  @media (max-width: 920px) {
    .employer {
      grid-template-columns: 1fr;
      gap: 18px;
      padding-left: 26px;
    }

    .more {
      margin-left: 26px;
    }
  }
</style>
