---
import { person } from '../data/profile';
import Brand from './icons/Brand.astro';

// Email is the way to reach me; the others are for finding out more.
const links = [
  { name: 'linkedin', label: 'LinkedIn', href: person.linkedin },
  { name: 'github', label: 'GitHub', href: person.github },
  { name: 'cv', label: 'Download CV', href: person.cv },
] as const;
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <p class="kicker reveal">Contact</p>
    <h2 id="contact-title" class="reveal">
      Let's build something great.
    </h2>
    <p class="lede reveal">
      A platform to design, a migration to plan, or a pipeline to automate? Let's talk.
    </p>
    <div class="email reveal">
      <a href={`mailto:${person.email}`}>
        <Brand name="email" />
        Send me an email
      </a>
      {/* The address, copied in one tap; without JavaScript, plain text to select. */}
      <p class="address">
        <span class="plain">{person.email}</span>
        <button
          class="copy"
          type="button"
          data-email={person.email}
          aria-label={`Copy the email address, ${person.email}`}
        >
          <span class="value">{person.email}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="9" y="9" width="11" height="11" rx="2"></rect>
            <path d="M5 15V6a2 2 0 0 1 2-2h8"></path>
          </svg>
          <span class="done" aria-hidden="true">
            Copied
          </span>
        </button>
        <span class="status sr-only" aria-live="polite"></span>
      </p>
    </div>
    <ul class="links reveal">
      {links.map(({ name, label, href }) => (
        <li>
          {/* Profiles open beside the site, so a visitor can come back to it. */}
          <a
            href={href}
            rel="noopener"
            target={name === 'cv' ? undefined : '_blank'}
            download={name === 'cv' ? 'Terencio-Agozzino-CV.pdf' : undefined}
          >
            <Brand name={name} />
            {label}
            {name !== 'cv' && <span class="sr-only"> (opens in a new tab)</span>}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<footer>
  <div class="wrap">
    <span class="sig">
      {person.firstName} {person.lastName}
    </span>
    <span>
      © {new Date().getFullYear()} · {person.country}
    </span>
  </div>
</footer>

<script>
  const copy = document.querySelector<HTMLButtonElement>('.copy');
  const status = document.querySelector('.address .status');
  copy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copy.dataset.email!);
    } catch {
      // No clipboard access: select it instead, ready for the visitor to copy.
      getSelection()?.selectAllChildren(copy.querySelector('.value')!);
      return;
    }
    copy.classList.add('copied');
    if (status) status.textContent = 'Email address copied';
    window.goatcounter?.count({ path: 'copy email', title: 'Copy email', event: true });
    setTimeout(() => {
      copy.classList.remove('copied');
      if (status) status.textContent = '';
    }, 2000);
  });
</script>

<style>
  .contact {
    background: var(--closing);
    color: #ece8da;
    text-align: center;
  }

  .kicker {
    color: var(--gold);
  }

  h2 {
    font-size: 60px;
    letter-spacing: -2px;
  }

  .lede {
    margin-inline: auto;
    color: var(--closing-soft);
  }

  .email {
    margin-top: 40px;
  }

  .email a {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 17px 34px;
    border-radius: 12px;
    font-family: var(--font-title);
    font-size: 17px;
    font-weight: 600;
    background: #ece8da;
    color: #282019;
    transition: transform 0.25s;
  }

  .email a:hover {
    transform: translateY(-3px);
  }

  .email :global(svg) {
    width: 22px;
    height: 22px;
  }

  /* The address itself, for whoever would rather copy it. */
  .address {
    margin-top: 12px;
    font-size: 14px;
    color: var(--closing-soft);
  }

  .plain {
    user-select: all;
  }

  .copy {
    display: none;
    position: relative;
    align-items: center;
    gap: 8px;
    padding: 4px 8px;
    border: 0;
    border-radius: 8px;
    background: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
    transition:
      color 0.2s,
      background 0.2s;
  }

  :global(.js) .copy {
    display: inline-flex;
  }

  :global(.js) .plain {
    display: none;
  }

  /* Only where there is a pointer to hover with: on a phone, a tap would leave
     the highlight behind. */
  @media (hover: hover) {
    .copy:hover:not(.copied) {
      color: #ece8da;
      background: rgb(236 232 218 / 0.08);
    }
  }

  .copy svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  /* "Copied" stands where the icon was for two seconds; the icon keeps its
     room, so the address does not move. */
  .done {
    display: none;
    position: absolute;
    left: calc(100% - 23px);
    font-weight: 600;
    color: var(--gold);
    white-space: nowrap;
  }

  .copy.copied svg {
    visibility: hidden;
  }

  .copy.copied .done {
    display: inline;
  }

  .links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
    list-style: none;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 22px;
    border-radius: 12px;
    font-weight: 600;
    font-size: 15px;
    color: #ece8da;
    border: 1.5px solid rgb(236 232 218 / 0.35);
    transition:
      border-color 0.25s,
      background 0.25s;
  }

  .links a:hover {
    border-color: #ece8da;
    background: rgb(236 232 218 / 0.08);
  }

  /* On the dark green, the marks take the text colour. */
  .links :global(svg) {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  footer {
    background: var(--closing);
    color: var(--closing-soft);
    font-size: 13px;
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }

  footer .wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-block: 22px;
  }

  .sig {
    font-family: var(--font-name);
    color: #ece8da;
  }

  @media (max-width: 920px) {
    h2 {
      font-size: 38px;
    }

    footer .wrap {
      flex-direction: column;
      text-align: center;
    }
  }

  /* Phones: one button per row, all the same width. */
  @media (max-width: 480px) {
    .email a,
    .links {
      width: 100%;
      max-width: 320px;
    }

    .email a {
      justify-content: center;
    }

    .links {
      flex-direction: column;
      margin-inline: auto;
    }

    .links a {
      width: 100%;
      justify-content: center;
    }
  }
</style>
