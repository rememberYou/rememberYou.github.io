---
import { person } from '../data/profile';
import Brand from './icons/Brand.astro';

// Email is the way to reach me; the others are for finding out more.
const links = [
  { name: 'linkedin', label: 'LinkedIn', href: person.linkedin },
  { name: 'github', label: 'GitHub', href: person.github },
  { name: 'cv', label: 'Download CV', href: person.cv },
] as const;
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <p class="kicker reveal">Contact</p>
    <h2 id="contact-title" class="reveal">
      Let's build something great.
    </h2>
    <p class="lede reveal">
      A platform to design, a migration to plan, or a pipeline to automate? Let's talk.
    </p>
    <div class="email reveal">
      <a href={`mailto:${person.email}`}>
        <Brand name="email" />
        Send me an email
      </a>
      <p>{person.email}</p>
    </div>
    <ul class="links reveal">
      {links.map(({ name, label, href }) => (
        <li>
          <a
            href={href}
            rel="noopener"
            download={name === 'cv' ? 'Terencio-Agozzino-CV.pdf' : undefined}
          >
            <Brand name={name} />
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<footer>
  <div class="wrap">
    <span class="sig">
      {person.firstName} {person.lastName}
    </span>
    <span>
      © {new Date().getFullYear()} · {person.country}
    </span>
  </div>
</footer>

<style>
  .contact {
    background: var(--closing);
    color: #ece8da;
    text-align: center;
  }

  .kicker {
    color: var(--gold);
  }

  h2 {
    font-size: 60px;
    letter-spacing: -2px;
  }

  .lede {
    margin-inline: auto;
    color: var(--closing-soft);
  }

  .email {
    margin-top: 40px;
  }

  .email a {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 17px 34px;
    border-radius: 12px;
    font-family: var(--font-title);
    font-size: 17px;
    font-weight: 600;
    background: #ece8da;
    color: #282019;
    transition: transform 0.25s;
  }

  .email a:hover {
    transform: translateY(-3px);
  }

  .email :global(svg) {
    width: 22px;
    height: 22px;
  }

  /* The address itself, for whoever would rather copy it. */
  .email p {
    margin-top: 12px;
    font-size: 14px;
    color: var(--closing-soft);
    user-select: all;
  }

  .links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
    list-style: none;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 22px;
    border-radius: 12px;
    font-weight: 600;
    font-size: 15px;
    color: #ece8da;
    border: 1.5px solid rgb(236 232 218 / 0.35);
    transition:
      border-color 0.25s,
      background 0.25s;
  }

  .links a:hover {
    border-color: #ece8da;
    background: rgb(236 232 218 / 0.08);
  }

  /* On the dark green, the marks take the text colour. */
  .links :global(svg) {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  footer {
    background: var(--closing);
    color: var(--closing-soft);
    font-size: 13px;
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }

  footer .wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-block: 22px;
  }

  .sig {
    font-family: var(--font-name);
    color: #ece8da;
  }

  @media (max-width: 920px) {
    h2 {
      font-size: 38px;
    }

    footer .wrap {
      flex-direction: column;
      text-align: center;
    }
  }

  /* Phones: one button per row, all the same width. */
  @media (max-width: 480px) {
    .email a,
    .links {
      width: 100%;
      max-width: 320px;
    }

    .email a {
      justify-content: center;
    }

    .links {
      flex-direction: column;
      margin-inline: auto;
    }

    .links a {
      width: 100%;
      justify-content: center;
    }
  }
</style>
