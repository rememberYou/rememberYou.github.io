---
import { Picture } from 'astro:assets';

import portrait from '../assets/portrait.png';
import { person } from '../data/profile';
import Arrow from './icons/Arrow.astro';
import Download from './icons/Download.astro';
---

<header class="wrap hero" id="top">
  <div>
    <h1 class="reveal">
      {person.firstName}
      <br />
      {person.lastName}
    </h1>
    <p class="role reveal">
      {person.role} <span aria-hidden="true">|</span> {person.credentials}
    </p>
    <p class="pitch reveal">{person.pitch}</p>
    <div class="actions reveal">
      <a class="btn primary" href="#contact">
        Get in touch <Arrow />
      </a>
      <a class="btn outline" href={person.cv} download="Terencio-Agozzino-CV.pdf">
        Download CV <Download />
      </a>
    </div>
  </div>
  <div class="photo-wrap reveal">
    <Picture
      class="photo"
      src={portrait}
      alt={`${person.firstName} ${person.lastName}`}
      formats={['avif', 'webp']}
      widths={[320, 420, 640, 800]}
      fallbackFormat="jpg"
      quality={90}
      sizes="(max-width: 920px) 320px, 420px"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</header>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 64px;
    align-items: center;
    padding-top: 72px;
    padding-bottom: 96px;
  }

  h1 {
    font-family: var(--font-name);
    font-weight: 400;
    font-size: 80px;
    line-height: 1.04;
    letter-spacing: 1px;
  }

  .role {
    margin-top: 22px;
    font-family: var(--font-title);
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.3px;
  }

  .role span {
    color: var(--primary);
  }

  .pitch {
    margin-top: 14px;
    max-width: 540px;
    font-size: 18px;
    color: var(--soft);
  }

  .actions {
    display: flex;
    gap: 14px;
    margin-top: 34px;
    flex-wrap: wrap;
  }

  .photo-wrap {
    position: relative;
    justify-self: end;
    width: 100%;
    max-width: 440px;
  }

  /* A soft glow of the accent colour behind the portrait. */
  .photo-wrap::before {
    content: '';
    position: absolute;
    inset: 8% -6% -10%;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--primary) 24%, transparent),
      transparent
    );
    filter: blur(24px);
  }

  .photo-wrap :global(.photo) {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 32px;
    outline: 1px solid rgb(255 255 255 / 0.12);
    outline-offset: -1px;
    box-shadow:
      0 2px 6px rgb(20 14 8 / 0.08),
      0 30px 60px -30px rgb(20 14 8 / 0.45);
  }

  @media (max-width: 920px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 48px;
      padding-top: 40px;
      padding-bottom: 72px;
    }

    h1 {
      font-size: 46px;
    }

    .role {
      font-size: 19px;
    }

    .pitch {
      font-size: 16px;
    }

    .photo-wrap {
      justify-self: center;
      max-width: 320px;
    }
  }

  /* Phones: the two buttons share the row, or stack at full width. */
  @media (max-width: 480px) {
    .actions .btn {
      flex: 1 1 auto;
      justify-content: center;
    }
  }
</style>
